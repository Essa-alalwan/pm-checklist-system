generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches the table connect-pg-simple creates/manages at runtime — modeled
// here purely so Prisma doesn't see it as unmanaged drift on every migration.
// Prisma never writes to this table; connect-pg-simple owns it exclusively.
model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum UserRole {
  technician
  supervisor
}

enum RecordStatus {
  submitted
  reviewed
}

enum ItemStatus {
  done
  na
  flagged
}

enum AuditAction {
  created
  reviewed
  edited
}

enum LogFieldType {
  text
  number
}

model User {
  id               String   @id @default(uuid())
  name             String
  username         String   @unique
  passwordHash     String
  role             UserRole
  department       String
  signatureDataUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdRecords ChecklistRecord[]
  auditEvents    ChecklistAuditEvent[]
}

model ChecklistTemplate {
  id          String   @id @default(uuid())
  type        String   @unique
  label       String
  shortLabel  String
  description String
  createdAt   DateTime @default(now())

  items             ChecklistTemplateItem[]
  measurementFields ChecklistTemplateMeasurementField[]
  logFields         ChecklistTemplateLogField[]
  records           ChecklistRecord[]
}

model ChecklistTemplateItem {
  id         String @id @default(uuid())
  templateId String
  itemKey    String
  label      String
  sortOrder  Int

  template    ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recordItems ChecklistRecordItem[]

  @@unique([templateId, itemKey])
}

// One row = one fillable measurement cell for an uploaded/custom checklist
// type. Rendering pivots this flat list into tables: fields sharing a
// groupLabel render together; if the group has more than one distinct
// rowLabel it becomes a real row x column table (rowLabel x columnLabel),
// otherwise it renders as a flat list of labeled fields (one per
// columnLabel). Mirrors the shape of ChecklistTemplateItem — a template-level
// definition, not a value. See server/src/mappers/readings.ts for how a
// filled-in value for one of these fields is stored (reuses ChecklistReading,
// keyed by this row's own id).
model ChecklistTemplateMeasurementField {
  id          String       @id @default(uuid())
  templateId  String
  groupLabel  String?
  rowLabel    String?
  columnLabel String
  unit        String?
  fieldType   LogFieldType @default(number)
  sortOrder   Int

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

// A column definition for a repeatable-row "log" table — for source tables
// whose row count isn't fixed (e.g. "record a result for however many
// cables you tested today"), unlike ChecklistTemplateMeasurementField which
// assumes a known, fixed set of rows. A template can define more than one
// log (distinguished by groupLabel). See server/src/mappers/logs.ts for how
// a submitted row's cells are stored (ChecklistLogCell, one per rowIndex).
model ChecklistTemplateLogField {
  id          String       @id @default(uuid())
  templateId  String
  groupLabel  String
  columnLabel String
  fieldType   LogFieldType
  unit        String?
  sortOrder   Int

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model ChecklistRecord {
  id                   String       @id @default(uuid())
  templateId           String
  kksCode              String
  equipmentDescription String
  date                 String
  preparedBy           String
  doneBy               String
  numberOfHelpers      Int
  reviewedBy           String?
  reviewedAt           DateTime?
  status               RecordStatus @default(submitted)
  signatureDataUrl     String
  remarks              String?
  createdByUserId      String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  template    ChecklistTemplate     @relation(fields: [templateId], references: [id])
  createdBy   User                  @relation(fields: [createdByUserId], references: [id])
  items       ChecklistRecordItem[]
  readings    ChecklistReading[]
  logCells    ChecklistLogCell[]
  auditEvents ChecklistAuditEvent[]

  @@index([kksCode])
  @@index([doneBy])
  @@index([date])
  @@index([status])
}

model ChecklistRecordItem {
  id             String     @id @default(uuid())
  recordId       String
  templateItemId String
  status         ItemStatus
  note           String?

  record       ChecklistRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem @relation(fields: [templateItemId], references: [id])

  @@unique([recordId, templateItemId])
}

model ChecklistReading {
  id         String   @id @default(uuid())
  recordId   String
  key        String
  groupLabel String?
  value      Decimal? @db.Decimal(12, 4)
  textValue  String? // e.g. "N/A" when a technician couldn't get a numeric reading
  unit       String?
  sortOrder  Int

  record ChecklistRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([key])
}

// One submitted cell within a repeatable-row log. (recordId, groupLabel,
// rowIndex) identifies one row the technician added; templateLogFieldId
// identifies which column. A text column uses textValue; a number column
// uses numericValue, with textValue "N/A" for an explicit N/A entry —
// mirrors the split ChecklistReading already uses for NumericOrNA.
model ChecklistLogCell {
  id                 String   @id @default(uuid())
  recordId           String
  groupLabel         String
  rowIndex           Int
  templateLogFieldId String
  textValue          String?
  numericValue       Decimal? @db.Decimal(12, 4)

  record ChecklistRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model ChecklistAuditEvent {
  id          String      @id @default(uuid())
  recordId    String
  action      AuditAction
  actorUserId String
  occurredAt  DateTime    @default(now())
  metadata    Json?

  record ChecklistRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor  User            @relation(fields: [actorUserId], references: [id])
}
